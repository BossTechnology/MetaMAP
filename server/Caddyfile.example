# Caddy equivalent (if the VPS uses Caddy instead of nginx)
metamap.bzzzbx.com {
    root * /var/www/metamap
    redir / /engine.html 302
    handle /api/ai {
        reverse_proxy BOB_AI_UPSTREAM {        # ← BOb's AI service address
            header_up X-Engine metamap
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "microphone=(self), camera=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'"
    }
    header /engine.html Cache-Control "no-cache"
    header /vendor/* Cache-Control "public, max-age=2592000, immutable"
    encode gzip
    file_server
}
